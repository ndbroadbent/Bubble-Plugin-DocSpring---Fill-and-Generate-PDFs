{
    "category": "plugins",
    "display": "DocSpring - Find Submissions",
    "fields": {
        "ADF": {
            "caption": "Template ID",
            "doc": "Optional. Only find this template's submissions.",
            "editor": "DynamicValue",
            "name": "templateId",
            "optional": true,
            "rank": 0,
            "value": "text"
        },
        "ADG": {
            "caption": "Test or Live",
            "default_val": "any",
            "doc": "Find test submissions, live submissions, or any.",
            "editor": "Dropdown",
            "name": "testFilter",
            "options": "any,live,test",
            "rank": 1
        },
        "ADH": {
            "caption": "Created After",
            "doc": "Optional. Only find submissions created after this time.",
            "editor": "DynamicValue",
            "name": "createdAfter",
            "optional": true,
            "rank": 2,
            "value": "date"
        },
        "ADI": {
            "caption": "Created Before",
            "doc": "Optional. Only find submissions created before this time.",
            "editor": "DynamicValue",
            "name": "createdBefore",
            "optional": true,
            "rank": 3,
            "value": "date"
        },
        "ADJ": {
            "caption": "Include Data",
            "default_val": false,
            "doc": "Include each submission's data in Response JSON.",
            "editor": "Checkbox",
            "name": "includeData",
            "rank": 4
        },
        "ADK": {
            "caption": "Limit",
            "doc": "Optional. How many to return, from 1 to 100. Default 50.",
            "editor": "DynamicValue",
            "name": "limit",
            "optional": true,
            "rank": 5,
            "value": "number"
        },
        "ADL": {
            "caption": "Cursor",
            "doc": "Optional. The Next Cursor from the previous page, to get the next page.",
            "editor": "DynamicValue",
            "name": "cursor",
            "optional": true,
            "rank": 6,
            "value": "text"
        }
    },
    "return_value": {
        "ACK": {
            "caption": "Success",
            "name": "success",
            "rank": 0,
            "value": "boolean"
        },
        "ACL": {
            "caption": "Submission IDs",
            "is_list": true,
            "name": "ids",
            "rank": 1,
            "value": "text"
        },
        "ACM": {
            "caption": "Submission States",
            "is_list": true,
            "name": "states",
            "rank": 2,
            "value": "text"
        },
        "ACN": {
            "caption": "PDF Files",
            "is_list": true,
            "name": "files",
            "rank": 3,
            "value": "file"
        },
        "ACO": {
            "caption": "Next Cursor",
            "name": "nextCursor",
            "rank": 4,
            "value": "text"
        },
        "ACP": {
            "caption": "Error Message",
            "name": "errorMessage",
            "rank": 5,
            "value": "text"
        },
        "ACQ": {
            "caption": "Response JSON",
            "name": "response",
            "rank": 6,
            "value": "text"
        }
    },
    "type": "server_side"
}