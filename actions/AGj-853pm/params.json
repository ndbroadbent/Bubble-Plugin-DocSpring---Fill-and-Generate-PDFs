        },
        "ACL": {
            "caption": "Template ID",
            "name": "id",
            "rank": 1,
            "value": "text"
        },
        "ACM": {
            "caption": "Name",
            "name": "name",
            "rank": 2,
            "value": "text"
        },
        "ACN": {
            "caption": "Template Type",
            "name": "templateType",
            "rank": 3,
            "value": "text"
        },
        "ACO": {
            "caption": "Ready",
            "name": "ready",
            "rank": 4,
            "value": "boolean"
        },
        "ACP": {
            "caption": "PDF State",
            "name": "documentState",
