{
    "category": "plugins",
    "display": "DocSpring - Create Template",
    "fields": {
        "AGT": {
            "caption": "Name",
            "doc": "The template's name.",
            "editor": "DynamicValue",
            "name": "name",
            "optional": true,
            "rank": 0,
            "value": "text"
        },
        "AGU": {
            "caption": "Template Type",
            "default_val": "pdf",
            "doc": "pdf: fields placed on a PDF you upload. html: a PDF made from HTML.",
            "editor": "Dropdown",
            "name": "templateType",
            "options": "pdf,html",
            "rank": 1
        },
        "AGV": {
            "caption": "Document",
            "doc": "For a PDF template: the PDF, as a file or an https:// URL (up to 100 MB).",
            "editor": "DynamicValue",
            "name": "document",
            "optional": true,
            "rank": 2,
            "value": "file"
        },
        "AGW": {
            "caption": "Document (Base64)",
            "doc": "Optional. The PDF encoded as base64 instead of Document (up to 7 MB).",
            "editor": "DynamicValue",
            "name": "documentBase64",
            "optional": true,
            "rank": 3,
            "value": "text"
        },
        "AGX": {
            "caption": "Filename",
            "doc": "Optional. The PDF's file name.",
            "editor": "DynamicValue",
            "name": "filename",
            "optional": true,
            "rank": 4,
            "value": "text"
        },
        "AGY": {
            "caption": "Detect Fields",
            "default_val": false,
            "doc": "Set up the PDF's fields automatically: import a fillable PDF's fields or detect them, and name them with AI.",
            "editor": "Checkbox",
            "name": "detectFields",
            "rank": 5
        },
        "AGZ": {
            "caption": "Field Source",
            "doc": "With Detect Fields: auto (default), pdf_detection or pdf_form_fields.",
            "editor": "Dropdown",
            "name": "fieldSource",
            "optional": true,
            "options": "auto,pdf_detection,pdf_form_fields",
            "rank": 6
        },
        "AGa": {
            "caption": "Field Naming",
            "doc": "With Detect Fields: ai (default) or preserve the PDF's field names.",
            "editor": "Dropdown",
            "name": "fieldNaming",
            "optional": true,
            "options": "ai,preserve",
            "rank": 7
        },
        "AGb": {
            "caption": "Field Logic",
            "doc": "With Detect Fields: ai (default) sets up conditional logic and required fields, none doesn't.",
            "editor": "Dropdown",
            "name": "fieldLogic",
            "optional": true,
            "options": "ai,none",
            "rank": 8
        },
        "AGc": {
            "caption": "HTML",
            "doc": "For an HTML template: its HTML (a Liquid template).",
            "editor": "DynamicValue",
            "name": "html",
            "optional": true,
            "rank": 9,
            "value": "text"
        },
        "AGd": {
            "caption": "SCSS",
            "doc": "For an HTML template: its SCSS.",
            "editor": "DynamicValue",
            "name": "scss",
            "optional": true,
            "rank": 10,
            "value": "text"
        },
        "AGe": {
            "caption": "Header HTML",
            "doc": "For an HTML template: HTML printed at the top of each page.",
            "editor": "DynamicValue",
            "name": "headerHtml",
            "optional": true,
            "rank": 11,
            "value": "text"
        },
        "AGf": {
            "caption": "Footer HTML",
            "doc": "For an HTML template: HTML printed at the bottom of each page.",
            "editor": "DynamicValue",
            "name": "footerHtml",
            "optional": true,
            "rank": 12,
            "value": "text"
        },
        "AGg": {
            "caption": "Folder ID",
            "doc": "Optional. The folder to create the template in. Starts with 'fld_'.",
            "editor": "DynamicValue",
            "name": "folderId",
            "optional": true,
            "rank": 13,
            "value": "text"
        },
        "AGh": {
            "caption": "Wait",
            "default_val": true,
            "doc": "Wait up to 45 seconds for the PDF to be processed. Turn it off to return straight away.",
            "editor": "Checkbox",
            "name": "wait",
            "rank": 14
        }
    },
    "return_value": {
        "ACK": {
            "caption": "Success",
            "name": "success",
            "rank": 0,
