{
    "category": "plugins",
    "display": "DocSpring - Replace Template PDF",
    "fields": {
        "AGk": {
            "caption": "Template ID",
            "doc": "Starts with 'tpl_'. Find it in your DocSpring account, or with Find Templates.",
            "editor": "DynamicValue",
            "name": "templateId",
            "rank": 0,
            "value": "text"
        },
        "AGl": {
            "caption": "Document",
            "doc": "The new PDF, as a file or an https:// URL (up to 100 MB).",
            "editor": "DynamicValue",
            "name": "document",
            "optional": true,
            "rank": 1,
            "value": "file"
        },
        "AGm": {
            "caption": "Document (Base64)",
            "doc": "Optional. The PDF encoded as base64 instead of Document (up to 7 MB).",
            "editor": "DynamicValue",
            "name": "documentBase64",
            "optional": true,
            "rank": 2,
            "value": "text"
        },
        "AGn": {
            "caption": "Filename",
            "doc": "Optional. The PDF's file name.",
            "editor": "DynamicValue",
            "name": "filename",
            "optional": true,
            "rank": 3,
            "value": "text"
        },
        "AGo": {
            "caption": "Reimport Fields",
            "default_val": false,
            "doc": "Replace all of the template's fields with the fillable fields in the new PDF.",
            "editor": "Checkbox",
            "name": "reimportFields",
            "rank": 4
        },
        "AGp": {
            "caption": "Wait",
            "default_val": true,
            "doc": "Wait up to 45 seconds for the PDF to be processed. Turn it off to return straight away.",
            "editor": "Checkbox",
            "name": "wait",
            "rank": 5
        }
    },
    "return_value": {
        "ACK": {
            "caption": "Success",
            "name": "success",
            "rank": 0,
            "value": "boolean"
        },
        "ACL": {
            "caption": "Template ID",
            "name": "id",
            "rank": 1,
            "value": "text"
        },
        "ACM": {
            "caption": "Name",
            "name": "name",
            "rank": 2,
            "value": "text"
        },
        "ACN": {
            "caption": "Template Type",
            "name": "templateType",
            "rank": 3,
            "value": "text"
        },
        "ACO": {
            "caption": "Ready",
            "name": "ready",
            "rank": 4,
            "value": "boolean"
        },
        "ACP": {
            "caption": "PDF State",
            "name": "documentState",
            "rank": 5,
            "value": "text"
        },
        "ACQ": {
            "caption": "Error Message",
            "name": "errorMessage",
            "rank": 6,
            "value": "text"
        },
        "ACR": {
            "caption": "Response JSON",
            "name": "response",
            "rank": 7,
            "value": "text"
        }
    },
    "type": "server_side"
}